# 统一换行符：仓库内存 LF，检出时按平台自动转换
* text=auto eol=lf

# Windows 脚本保留 CRLF，避免 cmd / PowerShell 解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell 脚本强制 LF
*.sh   text eol=lf

# 二进制文件不做换行符转换，也不参与 diff 统计
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.gif      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.pdf      binary
*.zip      binary
*.wasm     binary
*.ort      binary
*.so       binary
*.dll      binary
*.node     binary
*.apk      binary
*.aar      binary
*.jar      binary

# lock 文件在 diff 里折叠，代码评审才看得清重点
package-lock.json  -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated
pubspec.lock       -diff linguist-generated

# 让 GitHub 语言统计认得出这两端
*.dart     linguist-language=Dart
*.prisma   linguist-language=Prisma
