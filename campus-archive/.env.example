# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）

# SQLite 数据库连接（生产若迁移至 PostgreSQL，直接更换为 postgresql:// 连接串）
DATABASE_URL="file:./dev.db"

# 存储驱动类型：local（默认本地磁盘）| oss / s3（对象存储扩展）
STORAGE_DRIVER="local"

# 会话签名密钥：必须为高强度随机串（openssl rand -hex 32）
AUTH_SECRET=""

# 敏感文件加密主密钥：必须为 64 位 hex（openssl rand -hex 32）
# ⚠️ 若线上已存在"未配 MASTER_KEY 时期"加密的 .enc 文件，须沿用当时的 dev 派生密钥
# 才能解密，派生方式见 src/lib/crypto.ts，解密迁移完成后应立即换回随机密钥
MASTER_KEY=""

# HTTPS 部署后设为 true（启用 secure Cookie 与 HSTS）
COOKIE_SECURE="false"

# 仅当确认处于可信反向代理后且 X-Real-IP 不可伪造时才设为 true
TRUST_PROXY="false"

# 系统默认 AI 服务（用户可在设置页覆盖为自己的 Key）
# 支持接入 DeepSeek 官方或硅基流动/火山引擎/自建 vLLM 部署的多模态模型 (如 deepseek-vl, deepseek-vl2)
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"

# GitHub 仓库展示（可选，配置后限额 5000 次/小时）
GITHUB_TOKEN=""

# 审计日志保留天数（默认 180）
AUDIT_RETENTION_DAYS="180"
