/storage
*.db
*.db-journal

# 数据库与档案备份包
/backups

# OCR wasm 运行时：由 npm postinstall 从 node_modules/onnxruntime-web 复制生成
/public/ort

# 端到端测试：脚本入库，运行产物不入库
/.e2e/cookies.txt
/.e2e/dec.bin
/.e2e/export.zip
/test-idcard.jpg
/test-cert.jpg
/test-idcard-ocr.jpg
/test-license.jpg

# 本地隔离区（测试证件照、临时切图、审查报告等只留本机）
